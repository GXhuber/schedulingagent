# --- Identity ---------------------------------------------------------------
OWNER_NAME="Your Name"
OWNER_EMAIL=you@yourfirm.com
AGENT_NAME="Your Scheduling Assistant"
AGENT_EMAIL=your-scheduler@gmail.com

# --- Agent mailbox (Gmail: create an App Password, requires 2-step verification) ---
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Calendar ---------------------------------------------------------------
# "mock" until IT provisions the Azure AD app registration, then "graph".
CALENDAR_BACKEND=mock
MOCK_CALENDAR_PATH=mock_calendar.json
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=organizations
GRAPH_TOKEN_CACHE_PATH=graph_token_cache.json
# For serverless: base64 of graph_token_cache.json (store in a secrets manager, not in plain env)
GRAPH_TOKEN_CACHE_B64=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Scheduling preferences -------------------------------------------------
OWNER_TIMEZONE=America/New_York
WORK_START_HOUR=9
WORK_END_HOUR=17
DEFAULT_DURATION_MINUTES=30
BUFFER_MINUTES=15
MIN_NOTICE_HOURS=24
LOOKAHEAD_DAYS=10
MAX_PROPOSED_SLOTS=4

# --- Safety -----------------------------------------------------------------
# true = log what would be sent/booked without doing it. Flip to false only after testing.
DRY_RUN=true
ALWAYS_CC_OWNER=true
# Optional comma-separated allowlist; empty = anyone the owner is on a thread with
ALLOWED_SENDER_DOMAINS=
MAX_THREADS_PER_RUN=10
