# --- Identity ---------------------------------------------------------------
OWNER_NAME="Your Name"
OWNER_EMAIL=you@yourfirm.com
AGENT_NAME="Scheduling Assistant"
# Firm-provisioned mailbox (shared mailbox is fine) in the same M365 tenant
AGENT_EMAIL=scheduler@yourfirm.com

# --- Microsoft Graph (one app registration covers mail + calendar) -----------
# app       = client credentials, recommended with a firm mailbox (no interactive sign-in)
# delegated = device-code sign-in as the owner; calendar only, pair with EMAIL_BACKEND=imap
GRAPH_AUTH_MODE=app
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=          # app mode only; store in a secrets manager
GRAPH_TOKEN_CACHE_PATH=graph_token_cache.json   # delegated mode only
GRAPH_TOKEN_CACHE_B64=                          # delegated mode on serverless

# --- Backends ---------------------------------------------------------------
EMAIL_BACKEND=graph            # graph | imap
CALENDAR_BACKEND=mock          # mock until IT delivers the app registration, then graph
MOCK_CALENDAR_PATH=mock_calendar.json

# --- IMAP/SMTP fallback (only if EMAIL_BACKEND=imap, e.g. a Gmail agent mailbox) ---
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Scheduling preferences -------------------------------------------------
OWNER_TIMEZONE=America/New_York
WORK_START_HOUR=9
WORK_END_HOUR=17
DEFAULT_DURATION_MINUTES=30
BUFFER_MINUTES=15
MIN_NOTICE_HOURS=24
LOOKAHEAD_DAYS=10
MAX_PROPOSED_SLOTS=4

# --- Safety -----------------------------------------------------------------
# true = log what would be sent/booked without doing it. Flip to false only after testing.
DRY_RUN=true
ALWAYS_CC_OWNER=true
# Optional comma-separated allowlist; empty = anyone the owner is on a thread with
ALLOWED_SENDER_DOMAINS=
MAX_THREADS_PER_RUN=10
